# Standalone Anime Mapping DB release consumer settings.

MAPPINGS_DB_PATH=data/mappings/mappings.db
MAPPINGS_MANIFEST_PATH=data/mappings/manifest.json
MAPPINGS_RELEASE_REPOSITORY=anime-db-project/anime-mapping-db
MAPPINGS_AUTO_UPDATE=1
MAPPINGS_CHECK_INTERVAL_SECONDS=3600
MAPPINGS_REQUEST_TIMEOUT_SECONDS=300
MAPPINGS_KEEP_PREVIOUS=1
