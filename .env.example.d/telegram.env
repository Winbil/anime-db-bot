# Telegram transport, sessions and administrator accounts.
# Keep BOT_TOKEN private.

BOT_TOKEN=
ADMIN_TELEGRAM_USER_IDS=
TELEGRAM_BOT_API_URL=
TELEGRAM_BOT_API_LOCAL=false
# Host path that corresponds to /var/lib/telegram-bot-api inside a local Bot API container.
# Leave empty when the bot process can access the returned file_path directly.
TELEGRAM_BOT_API_LOCAL_FILE_ROOT=
TELEGRAM_SESSION_TTL_SECONDS=3600
ANIME_INPUT_TTL_SECONDS=300
