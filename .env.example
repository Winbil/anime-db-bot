# Telegram bot token from @BotFather
BOT_TOKEN=

# Optional custom/self-hosted Telegram Bot API base URL.
# Leave empty to use the official https://api.telegram.org endpoint.
TELEGRAM_BOT_API_URL=

# Set to true only when your self-hosted telegram-bot-api server runs in --local mode.
TELEGRAM_BOT_API_LOCAL=false

# ---------------------------------------------------------------------------
# Search providers
# ---------------------------------------------------------------------------
# Search is independent from metadata sources.
# Shikimori and MyAnimeList search in parallel, then SearchService merges
# duplicate results strictly by MAL ID.

# MyAnimeList API v2.
# Recommended but no longer mandatory for starting the bot: if this value is
# empty or MAL is temporarily unavailable, Shikimori search can still work.
# Public MAL API requests use this value in X-MAL-CLIENT-ID.
# Create an API application at https://myanimelist.net/apiconfig and copy
# its Client ID here. OAuth/access tokens are NOT required for public search.
MAL_CLIENT_ID=
MAL_API_URL=https://api.myanimelist.net/v2

# Shikimori GraphQL is used both by the dedicated Shikimori search provider
# and by the Shikimori metadata source.
SHIKIMORI_API_URL=https://shikimori.io/api/graphql
SHIKIMORI_SITE_URL=https://shikimori.io

# In-memory search cache. Repeating the same query/page within the TTL does
# not call search providers again. Set TTL to 0 to disable caching.
SEARCH_CACHE_TTL_SECONDS=21600
SEARCH_CACHE_MAX_ENTRIES=500

# ---------------------------------------------------------------------------
# Metadata source: AniList
# ---------------------------------------------------------------------------
# AniList is NOT used for text search. It receives the selected MAL ID only.
# Public anime data does NOT require a client ID, client secret or access token.
ANILIST_API_URL=https://graphql.anilist.co

# Optional OAuth access token. Leave empty for the current public-data use case.
ANILIST_ACCESS_TOKEN=

# Maximum AniList staff/character pages fetched for one selected anime.
ANILIST_PEOPLE_MAX_PAGES=4
