# Telegram bot token from @BotFather
BOT_TOKEN=

# Privileged Telegram accounts. Comma/space/semicolon separated numeric user IDs.
# Administrators can use restricted moderation/diagnostic features and bypass the
# personal command rate limit. They NEVER bypass upstream source safety limits.
# Keep this server-owned configuration outside the user settings database.
ADMIN_TELEGRAM_USER_IDS=

# Moderation bans are intentionally persisted separately from user settings.
# Leave empty to use data/bans.sqlite3. For Docker this can point to a mounted volume.
BANS_DB_PATH=

# Optional custom/self-hosted Telegram Bot API base URL.
# Leave empty to use the official https://api.telegram.org endpoint.
TELEGRAM_BOT_API_URL=

# Set to true only when your self-hosted telegram-bot-api server runs in --local mode.
TELEGRAM_BOT_API_LOCAL=false

# Search-result and anime-card callback sessions live in RAM. The TTL is
# sliding: active cards are refreshed on use, abandoned callback tokens expire.
TELEGRAM_SESSION_TTL_SECONDS=3600

# /anime without arguments waits briefly for the next user message after the
# source selector is chosen. The pending input is scoped to that Telegram user
# and chat, and expires automatically.
ANIME_INPUT_TTL_SECONDS=300

# Per-user interface settings and known platform user IDs are persisted in SQLite.
# Leave empty to use data/user_settings.sqlite3.
# For Docker this can point to a mounted volume, e.g. /data/user_settings.sqlite3.
USER_SETTINGS_DB_PATH=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Personal limits are isolated by (platform, user_id). One active/abusive user
# therefore cannot consume another user's allowance. Administrators bypass these
# two PERSONAL buckets only. noop callbacks are not charged.
USER_RATE_LIMIT_PER_MINUTE=50
USER_RATE_LIMIT_PER_HOUR=1000

# Outbound source limits are independent from the personal limit. They protect
# application/token/IP-wide upstream quotas and apply to every user, including
# administrators. When a safety bucket is full the request waits for capacity;
# the user is not incorrectly told that they personally exceeded a limit.
# Source-specific values override the default. These defaults are intentionally
# conservative and can be tuned if an upstream account has a different quota.
UPSTREAM_RATE_LIMIT_DEFAULT_PER_MINUTE=120
UPSTREAM_RATE_LIMIT_ANILIST_PER_MINUTE=80
UPSTREAM_RATE_LIMIT_SHIKIMORI_PER_MINUTE=240
UPSTREAM_RATE_LIMIT_MAL_PER_MINUTE=120

# Optional operation-specific buckets make expensive paths stricter while every
# request still consumes the source-global bucket above. Built-in defaults are
# AniList people=20/min and Shikimori people=60/min. The explicit values below
# document those defaults. The same naming pattern can be used for SEARCH or
# METADATA, e.g. UPSTREAM_RATE_LIMIT_ANILIST_SEARCH_PER_MINUTE=60.
UPSTREAM_RATE_LIMIT_ANILIST_PEOPLE_PER_MINUTE=20
UPSTREAM_RATE_LIMIT_SHIKIMORI_PEOPLE_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Search providers
# ---------------------------------------------------------------------------
# Search is independent from metadata sources.
# Fast /anime <title> search uses Shikimori + MyAnimeList + AniList in parallel.
# /anime without arguments still exposes All/MAL/Shikimori/AniList source
# selection. Results are merged by source-independent external IDs first and
# exact normalized romaji title second, with same-source ID conflicts separate.
# For a multi-source text search the best confirmed result can be enriched with
# metadata-source IDs/titles, then one bounded alternate-language query is used
# to discover editions that another provider indexes under a different language.

# MyAnimeList API v2.
# Recommended but not mandatory for starting the bot. If empty, MAL search and
# MAL metadata will be unavailable, while Shikimori/AniList can still work.
# Public MAL API requests use this value in X-MAL-CLIENT-ID.
# Create an API application at https://myanimelist.net/apiconfig and copy
# its Client ID here. OAuth/access tokens are NOT required for public data.
MAL_CLIENT_ID=
MAL_API_URL=https://api.myanimelist.net/v2

# Shikimori GraphQL is used by both its search provider and metadata source.
SHIKIMORI_API_URL=https://shikimori.io/api/graphql
SHIKIMORI_SITE_URL=https://shikimori.io

# Shikimori staff and character-backed seiyuu are intentionally NOT loaded
# while the main anime card is being built. Staff is fetched on first opening
# "Команда"; seiyuu are fetched on first opening "Сэйю".
# Seiyuu and individual character payloads are cached in RAM because cast data
# changes rarely and popular people are shared between many anime.
SHIKIMORI_PEOPLE_CACHE_TTL_SECONDS=21600

# Progressive staff/seiyuu loading limits expensive portrait hydration rather
# than the number of names. People without a portrait do not consume this budget;
# pagination can request another batch after the currently hydrated portraits.
PEOPLE_PORTRAIT_BATCH_SIZE=50

# Character-backed Shikimori seiyuu require REST character lookups. This controls
# the small internal lookup chunk used while filling one portrait batch. Smaller
# chunks reduce portrait-budget overshoot; larger chunks trade that for throughput.
SHIKIMORI_PEOPLE_CHARACTER_BATCH_SIZE=8

# Minimum spacing between all Shikimori REST requests in one bot process.
# 0.24 keeps request starts below the documented 5 requests/second boundary
# even when several Telegram users open cast data at the same time.
SHIKIMORI_REST_MIN_INTERVAL_SECONDS=0.24

# In-memory search cache. Repeating the same successful query/page or completed
# query collection within the TTL does not call search providers again.
# Partial/error collections are not cached. Set TTL to 0 to disable caching.
SEARCH_CACHE_TTL_SECONDS=21600
SEARCH_CACHE_MAX_ENTRIES=500

# /anime first builds a query-scoped relevant result set, then Telegram paginates
# that frozen set locally. These limits protect upstream APIs from deep provider
# pagination while allowing more than the first page of related titles.
SEARCH_COLLECTION_PAGE_SIZE=20
SEARCH_COLLECTION_MAX_PAGES=4
SEARCH_COLLECTION_MAX_ITEMS=120

# Minimum source-independent title relevance score (1..100). Exact, prefix,
# meaningful-token and conservative similarity matches are considered across
# display/romaji/native names and aliases. A provider stops being paged after
# this many consecutive pages contain no candidates meeting the threshold.
SEARCH_RELEVANCE_THRESHOLD=55
SEARCH_IRRELEVANT_TAIL_PAGES=1

# Bounded multilingual expansion for searches that use more than one provider.
# The top confirmed seed is enriched through metadata sources; only titles and
# aliases returned through confirmed identities can become alternate queries.
# No machine translation or same-number cross-database assumption is used.
SEARCH_EXPANSION_MAX_SEEDS=1
SEARCH_EXPANSION_MAX_QUERIES=1
SEARCH_EXPANSION_MAX_PAGES=2

# ---------------------------------------------------------------------------
# AniList
# ---------------------------------------------------------------------------
# AniList operates through source-independent AnimeIdentity and participates in
# fast default text search, interactive All search, explicit AniList search and
# direct-ID/cross-source identity enrichment.
ANILIST_API_URL=https://graphql.anilist.co

# Optional OAuth access token. Leave empty for public data.
ANILIST_ACCESS_TOKEN=

# Staff and Japanese voice actors are lazy: the main card does not paginate
# people. These settings control how much is loaded when the corresponding
# Telegram section is explicitly opened and how long it stays cached in RAM.
ANILIST_PEOPLE_MAX_PAGES=4
ANILIST_PEOPLE_CACHE_TTL_SECONDS=21600

# ---------------------------------------------------------------------------
# Metadata aggregation
# ---------------------------------------------------------------------------
# Enabled sources are currently Shikimori, AniList and MyAnimeList.
# They are not rendered as independent metadata blocks. Equivalent semantic
# fields are merged by the identity-native aggregation service: genres/studios/
# synonyms/etc. are unioned without duplicates, scalar values use normalized
# consensus rules, descriptions remain source-selectable, and scores are averaged.
# Locale-neutral canonical values are kept in the domain model; RU/EN labels
# are applied only by the platform renderer for the current user.