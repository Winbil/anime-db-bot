# Telegram bot token from @BotFather
BOT_TOKEN=

# Optional custom/self-hosted Telegram Bot API base URL.
#
# Leave empty:
#   start.sh runs bots.official
#   normal sendMessage is used
#   long text is split to stay below the 4096-character Bot API limit.
#
# Set a URL:
#   start.sh runs bots.tgapi
#   anime details are sent with sendRichMessage when possible
#   rich messages support up to 32768 UTF-8 characters.
#
# Example:
# TELEGRAM_BOT_API_URL=http://127.0.0.1:8081
TELEGRAM_BOT_API_URL=

# Set to true only when your self-hosted telegram-bot-api server runs in --local mode.
TELEGRAM_BOT_API_LOCAL=false

# Shikimori endpoints.
SHIKIMORI_API_URL=https://shikimori.io/api/graphql
SHIKIMORI_SITE_URL=https://shikimori.io
