# Telegram bot token from @BotFather
BOT_TOKEN=

# Bot logs default to sanitized JSON Lines for machine parsing. Timestamps use
# the timezone of the machine/container running the bot and include its UTC offset.
# LOG_STRUCTURED=0 switches to readable text logs.
LOG_LEVEL=INFO
LOG_STRUCTURED=1
# Secret/token redaction is ON by default. Set to 0 only for deliberate local
# diagnostics: credentials, bearer tokens, URL passwords and query secrets may
# then be written to logs verbatim. Never disable this on shared/public logs.
LOG_REDACT_SECRETS=1
# start.sh rotates logs/bot.log before launch when this size is reached.
LOG_MAX_BYTES=10485760
LOG_BACKUPS=5

# Privileged Telegram accounts. Comma/space/semicolon separated numeric user IDs.
# Administrators can use restricted moderation/diagnostic features and bypass the
# personal command rate limit. They NEVER bypass upstream source safety limits.
# Keep this server-owned configuration outside the user settings database.
ADMIN_TELEGRAM_USER_IDS=

# Moderation bans are intentionally persisted separately from user settings.
# Leave empty to use data/bans.sqlite3. For Docker this can point to a mounted volume.
BANS_DB_PATH=

# Optional custom/self-hosted Telegram Bot API base URL.
# Leave empty to use the official https://api.telegram.org endpoint.
TELEGRAM_BOT_API_URL=

# Set to true only when your self-hosted telegram-bot-api server runs in --local mode.
TELEGRAM_BOT_API_LOCAL=false

# Search-result and anime-card callback sessions live in RAM. The TTL is
# sliding: active cards are refreshed on use, abandoned callback tokens expire.
TELEGRAM_SESSION_TTL_SECONDS=3600

# /anime without arguments waits briefly for the next user message after the
# source selector is chosen. The pending input is scoped to that Telegram user
# and chat, and expires automatically.
ANIME_INPUT_TTL_SECONDS=300

# Per-user interface settings and known platform user IDs are persisted in SQLite.
# Leave empty to use data/user_settings.sqlite3.
USER_SETTINGS_DB_PATH=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
USER_RATE_LIMIT_PER_MINUTE=50
USER_RATE_LIMIT_PER_HOUR=1000
UPSTREAM_RATE_LIMIT_DEFAULT_PER_MINUTE=120
UPSTREAM_RATE_LIMIT_ANILIST_PER_MINUTE=80
UPSTREAM_RATE_LIMIT_SHIKIMORI_PER_MINUTE=240
UPSTREAM_RATE_LIMIT_MAL_PER_MINUTE=120
UPSTREAM_RATE_LIMIT_JIKAN_PER_MINUTE=30
UPSTREAM_RATE_LIMIT_JIKAN_METADATA_PER_MINUTE=20
UPSTREAM_RATE_LIMIT_JIKAN_PEOPLE_PER_MINUTE=15
UPSTREAM_RATE_LIMIT_JIKAN_TRAILERS_PER_MINUTE=15
UPSTREAM_RATE_LIMIT_JIKAN_EPISODES_PER_MINUTE=20
UPSTREAM_RATE_LIMIT_ANILIST_PEOPLE_PER_MINUTE=20
UPSTREAM_RATE_LIMIT_SHIKIMORI_PEOPLE_PER_MINUTE=60
# AniDB additionally enforces an internal serialized >=2.2 second spacing between
# actual HTTP API requests. Disk-cache hits do not create AniDB network traffic.
UPSTREAM_RATE_LIMIT_ANIDB_PER_MINUTE=20

# Source-level circuit breaker. After this many failed application calls (each
# normal call may already use its retry policy), the source is cooled down. Once
# cooldown expires, exactly one half-open recovery probe is allowed through.
SOURCE_HEALTH_FAILURE_THRESHOLD=3
SOURCE_HEALTH_COOLDOWN_SECONDS=30

# ---------------------------------------------------------------------------
# External cross-ID mapping database
# ---------------------------------------------------------------------------
# mappings.db is the runtime cross-ID resolver. Datasets and lookup indexes are
# NOT retained in RAM. The updater streams Fribb/anime-lists, Kometa-Team/Anime-IDs,
# Anime-Lists/anime-lists, cplieger/animap, manami anime-offline-database and
# AniBridge into SQLite, keeps provenance/evidence/conflicts, validates the new DB,
# then atomically replaces the old copy. Raw downloads are removed by default.
MAPPINGS_DB_PATH=data/mappings/mappings.db
MAPPINGS_AUTO_UPDATE=1
MAPPINGS_UPDATE_MAX_AGE_HOURS=24
MAPPINGS_CHECK_INTERVAL_SECONDS=3600
MAPPINGS_REQUEST_TIMEOUT_SECONDS=300
MAPPINGS_KEEP_DOWNLOADS=0
MAPPINGS_KEEP_PREVIOUS=1

# ---------------------------------------------------------------------------
# Search providers
# ---------------------------------------------------------------------------
# Search is independent from metadata sources. Fast /anime <title> search still
# uses Shikimori + MyAnimeList + AniList in parallel. AniDB does NOT add another
# network search request: confirmed IDs are enriched locally through mappings.db.

# MyAnimeList API v2.
MAL_CLIENT_ID=
MAL_API_URL=https://api.myanimelist.net/v2

# Local on-demand Jikan supplement. It is NOT a separate identity database.
JIKAN_API_URL=http://127.0.0.1:8091
JIKAN_PORT=8091
JIKAN_REQUEST_TIMEOUT_SECONDS=45
JIKAN_SUPPLEMENT_CACHE_TTL_SECONDS=21600
JIKAN_PEOPLE_CACHE_TTL_SECONDS=21600
JIKAN_UPDATE_IDLE_WAIT_SECONDS=300

# ---------------------------------------------------------------------------
# AniDB HTTP API
# ---------------------------------------------------------------------------
# Register an HTTP API client in AniDB and put the client name here. Public anime
# metadata does not require an AniDB username/password. Leave ANIDB_CLIENT empty to
# keep the AniDB source disabled while mappings.db can still resolve AniDB IDs.
ANIDB_CLIENT=
ANIDB_CLIENT_VERSION=1
ANIDB_HTTP_API_URL=http://api.anidb.net:9001/httpapi
ANIDB_REQUEST_TIMEOUT_SECONDS=45
# AniDB explicitly expects aggressive caching. XML anime payloads stay on disk,
# not in an in-memory metadata cache, and are reused by metadata/characters/staff/
# seiyuu/episodes capabilities.
ANIDB_CACHE_DIR=data/anidb
ANIDB_CACHE_TTL_SECONDS=86400

# Shikimori GraphQL is used by both its search provider and metadata source.
SHIKIMORI_API_URL=https://shikimori.io/api/graphql
SHIKIMORI_SITE_URL=https://shikimori.io
SHIKIMORI_PEOPLE_CACHE_TTL_SECONDS=21600
PEOPLE_PORTRAIT_BATCH_SIZE=50
SHIKIMORI_PEOPLE_CHARACTER_BATCH_SIZE=8
SHIKIMORI_REST_MIN_INTERVAL_SECONDS=0.24

# In-memory search cache. Mapping data is never stored here.
SEARCH_CACHE_TTL_SECONDS=21600
SEARCH_CACHE_MAX_ENTRIES=500
SEARCH_COLLECTION_PAGE_SIZE=20
SEARCH_COLLECTION_MAX_PAGES=4
SEARCH_COLLECTION_MAX_ITEMS=120
SEARCH_RELEVANCE_THRESHOLD=55
SEARCH_IRRELEVANT_TAIL_PAGES=1
SEARCH_EXPANSION_MAX_SEEDS=1
SEARCH_EXPANSION_MAX_QUERIES=1
SEARCH_EXPANSION_MAX_PAGES=2

# ---------------------------------------------------------------------------
# AniList
# ---------------------------------------------------------------------------
ANILIST_API_URL=https://graphql.anilist.co
ANILIST_ACCESS_TOKEN=
ANILIST_PEOPLE_MAX_PAGES=4
ANILIST_PEOPLE_CACHE_TTL_SECONDS=21600

# ---------------------------------------------------------------------------
# Metadata aggregation
# ---------------------------------------------------------------------------
# Always-available sources are Shikimori, AniList and MAL/Jikan. AniDB joins the
# same identity-native aggregation when ANIDB_CLIENT is configured and mappings.db
# has resolved (or direct lookup supplied) an AniDB AID. No external DB is primary.
