# Telegram bot token from @BotFather
BOT_TOKEN=

# Optional custom/self-hosted Telegram Bot API base URL.
#
# Leave empty:
#   start.sh runs bots.official and uses https://api.telegram.org
#
# Set a URL:
#   start.sh runs bots.tgapi and uses your custom/self-hosted telegram-bot-api
#
# In both modes detailed anime cards use sendRichMessage
# with up to 32768 UTF-8 characters. If sendRichMessage fails,
# the bot falls back to regular sendMessage chunks.
TELEGRAM_BOT_API_URL=

# Set to true only when your self-hosted telegram-bot-api server runs in --local mode.
TELEGRAM_BOT_API_LOCAL=false

# ---------------------------------------------------------------------------
# Search provider: MyAnimeList API v2
# ---------------------------------------------------------------------------
# Required. Public MAL API requests use this value in X-MAL-CLIENT-ID.
# Create an API application at https://myanimelist.net/apiconfig and copy
# its Client ID here. OAuth/access tokens are NOT required for public search.
MAL_CLIENT_ID=
MAL_API_URL=https://api.myanimelist.net/v2

# ---------------------------------------------------------------------------
# Metadata source: Shikimori
# ---------------------------------------------------------------------------
SHIKIMORI_API_URL=https://shikimori.io/api/graphql
SHIKIMORI_SITE_URL=https://shikimori.io

# ---------------------------------------------------------------------------
# Metadata source: AniList
# ---------------------------------------------------------------------------
# Public anime data does NOT require a client ID, client secret or access token.
ANILIST_API_URL=https://graphql.anilist.co

# Optional OAuth access token. Leave empty for the current public-data use case.
ANILIST_ACCESS_TOKEN=

# Maximum AniList staff/character pages fetched for one selected anime.
# No AniList requests are made during text search; AniList is queried only
# after the user selects a MAL result.
ANILIST_PEOPLE_MAX_PAGES=4
